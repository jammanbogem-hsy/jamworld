# 서버 전용 설정 (값은 .dev.vars 또는 Sites 시크릿/환경에. 이 파일에는 키 이름만)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 선택: 모델 덮어쓰기
OPENAI_MODEL=
ANTHROPIC_MODEL=
OPENAI_IMAGE_MODEL=
# 선택: 이미지 토큰 단가(JSON, USD/1M 토큰). 비우면 코드의 기본 요금표(검증일 표기) 사용
OPENAI_IMAGE_PRICING=
# 필수(교사 기능): 허용 교사 목록. 쉼표 구분 "email:주소" 또는 "siwc:사용자ID". 비어 있으면 교사 0명(fail-closed)
TEACHER_ALLOWLIST=
